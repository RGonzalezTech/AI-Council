# Copy to .env and fill in what you need. One provider key is enough.
# Any LiteLLM-supported provider works: https://docs.litellm.ai/docs/providers

OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Models ───────────────────────────────────────────────────
# Alias (see `council models`) or any LiteLLM string, e.g. openrouter/anthropic/claude-sonnet-4-5
COUNCIL_MODEL=deepseek
# Cheaper/faster model for Moderator duties (synthesis, triage, rewriting). Defaults to COUNCIL_MODEL.
# COUNCIL_MODERATOR_MODEL=deepseek-flash

# ── Debate ───────────────────────────────────────────────────
# COUNCIL_COUNCIL_SIZE=5
# COUNCIL_MAX_TURNS=15
# COUNCIL_MAX_RESOLUTION_TURNS=5
# COUNCIL_MAX_WORKERS=8

# ── Storage ──────────────────────────────────────────────────
# Defaults to ~/.aicouncil/sessions
# COUNCIL_SESSIONS_DIR=./sessions
