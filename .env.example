# ─── AI Council: API Keys ───────────────────────────────────
# Copy this file to .env and fill in the keys you need.
# You only need ONE provider configured to get started.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter (recommended — gives access to 200+ models with one key)
OPENROUTER_API_KEY=

# ─── AI Council: Model Configuration ────────────────────────
# The model to use by default. Can be one of the aliases defined in
# council/config.py (deepseek, deepseek-flash, gemini-flash, gemini-pro, etc.)
# or any raw LiteLLM model string (e.g. "openrouter/anthropic/claude-sonnet-4").
COUNCIL_MODEL=deepseek