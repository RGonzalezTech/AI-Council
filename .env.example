# Copy this file to .env and fill in what you need. One provider key is enough.
# Any LiteLLM-supported provider works: https://docs.litellm.ai/docs/providers

OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Models (any LiteLLM model string)
COUNCIL_MODEL=openrouter/deepseek/deepseek-v4-pro
# Cheaper model for Moderator duties (synthesis, triage, rewriting). Defaults to COUNCIL_MODEL.
# COUNCIL_MODERATOR_MODEL=openrouter/deepseek/deepseek-v4-flash

# Debate
# COUNCIL_COUNCIL_SIZE=5
# COUNCIL_MAX_TURNS=15
# COUNCIL_MAX_RESOLUTION_TURNS=5
# COUNCIL_MAX_WORKERS=8

# Storage (defaults to ~/.aicouncil/sessions)
# COUNCIL_SESSIONS_DIR=./sessions
